{
  "id": "com.briis.ttlock",
  "version": "1.1.1",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "platforms": [
    "local",
    "cloud"
  ],
  "name": {
    "en": "TTLock",
    "da": "TTLock"
  },
  "description": {
    "en": "Control and monitor your TTLock smart locks",
    "da": "Styr og overvåg dine TTLock smarte låse"
  },
  "category": [
    "security"
  ],
  "brandColor": "#1DA1F2",
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Bjarne Riis",
    "email": "bjarne@briis.com"
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "bjarne@briis.com"
      },
      "githubSponsors": {
        "username": "briis"
      }
    }
  },
  "bugs": {
    "url": "https://github.com/briis/ttlock-homey/issues"
  },
  "source": "https://github.com/briis/ttlock-homey",
  "support": "https://github.com/briis/ttlock-homey/issues",
  "drivers": [
    {
      "id": "lock",
      "name": {
        "en": "Lock",
        "da": "Lås"
      },
      "class": "lock",
      "platforms": [
        "local",
        "cloud"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "locked",
        "measure_battery",
        "alarm_battery",
        "measure_signal_strength",
        "onoff.autolock",
        "onoff.lock_sound",
        "passage_mode_enabled",
        "last_operator",
        "last_trigger"
      ],
      "capabilitiesOptions": {
        "onoff.autolock": {
          "title": {
            "en": "Auto Lock",
            "da": "Automatisk lås"
          }
        },
        "onoff.lock_sound": {
          "title": {
            "en": "Lock Sound",
            "da": "Låselyd"
          }
        }
      },
      "energy": {
        "batteries": [
          "OTHER"
        ]
      },
      "images": {
        "small": "/drivers/lock/assets/images/small.png",
        "large": "/drivers/lock/assets/images/large.png",
        "xlarge": "/drivers/lock/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials"
        }
      ]
    }
  ],
  "capabilities": {
    "last_operator": {
      "type": "string",
      "title": {
        "en": "Last Operator",
        "da": "Sidste bruger"
      },
      "desc": {
        "en": "Who last locked or unlocked the lock, from the most recent webhook event",
        "da": "Hvem der senest låste eller låste låsen op, fra den seneste webhook-hændelse"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "last_trigger": {
      "type": "string",
      "title": {
        "en": "Last Trigger",
        "da": "Seneste hændelse"
      },
      "desc": {
        "en": "What triggered the most recent lock event, e.g. \"unlock by app\" or \"auto lock\"",
        "da": "Hvad der udløste den seneste hændelse, f.eks. \"unlock by app\" eller \"auto lock\""
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "passage_mode_enabled": {
      "type": "boolean",
      "title": {
        "en": "Passage Mode",
        "da": "Gennemgangstilstand"
      },
      "desc": {
        "en": "Whether passage mode (the lock stays unlocked) is enabled",
        "da": "Om gennemgangstilstand (låsen forbliver ulåst) er aktiveret"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    }
  },
  "flow": {
    "triggers": [],
    "conditions": [],
    "actions": []
  },
  "api": {
    "getWebhookUrl": {
      "method": "GET",
      "path": "/webhook-url"
    }
  }
}