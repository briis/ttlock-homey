{
  "id": "com.briis.ttlock",
  "version": "1.1.2",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "platforms": [
    "local",
    "cloud"
  ],
  "name": {
    "en": "TTLock",
    "da": "TTLock"
  },
  "description": {
    "en": "Control and monitor your TTLock smart locks",
    "da": "Styr og overvåg dine TTLock smarte låse"
  },
  "category": [
    "security"
  ],
  "brandColor": "#1DA1F2",
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Bjarne Riis",
    "email": "bjarne@briis.com"
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "bjarne@briis.com"
      },
      "githubSponsors": {
        "username": "briis"
      }
    }
  },
  "bugs": {
    "url": "https://github.com/briis/ttlock-homey/issues"
  },
  "source": "https://github.com/briis/ttlock-homey",
  "support": "https://github.com/briis/ttlock-homey/issues",
  "drivers": [
    {
      "id": "lock",
      "name": {
        "en": "Lock",
        "da": "Lås"
      },
      "class": "lock",
      "platforms": [
        "local",
        "cloud"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "locked",
        "measure_battery",
        "alarm_battery",
        "measure_signal_strength",
        "autolock_enabled",
        "lock_sound_enabled",
        "passage_mode_enabled",
        "last_operator",
        "last_trigger"
      ],
      "energy": {
        "batteries": [
          "OTHER"
        ]
      },
      "images": {
        "small": "/drivers/lock/assets/images/small.png",
        "large": "/drivers/lock/assets/images/large.png",
        "xlarge": "/drivers/lock/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Polling"
          },
          "children": [
            {
              "id": "poll_interval",
              "type": "number",
              "label": {
                "en": "Lock state check interval (minutes)"
              },
              "hint": {
                "en": "How often lock state is re-verified with TTLock. Webhooks deliver changes in real time, so this is only reconciliation. Lower values use more of TTLock's free 30,000 API calls/month."
              },
              "value": 30,
              "min": 5,
              "max": 1440
            },
            {
              "id": "slow_poll_interval",
              "type": "number",
              "label": {
                "en": "Battery & settings refresh interval (hours)"
              },
              "hint": {
                "en": "How often battery, auto-lock, lock sound, passage mode and gateway signal are refreshed."
              },
              "value": 6,
              "min": 1,
              "max": 168
            }
          ]
        }
      ]
    }
  ],
  "capabilities": {
    "autolock_enabled": {
      "type": "boolean",
      "title": {
        "en": "Auto Lock",
        "da": "Automatisk lås"
      },
      "desc": {
        "en": "Whether the lock automatically locks itself a few seconds after being unlocked",
        "da": "Om låsen automatisk låser sig selv nogle sekunder efter at være blevet låst op"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle"
    },
    "lock_sound_enabled": {
      "type": "boolean",
      "title": {
        "en": "Lock Sound",
        "da": "Låselyd"
      },
      "desc": {
        "en": "Whether the lock plays a sound when operated",
        "da": "Om låsen afspiller en lyd, når den betjenes"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle"
    },
    "last_operator": {
      "type": "string",
      "title": {
        "en": "Last Operator",
        "da": "Sidste bruger"
      },
      "desc": {
        "en": "Who last locked or unlocked the lock, from the most recent webhook event",
        "da": "Hvem der senest låste eller låste låsen op, fra den seneste webhook-hændelse"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/last_operator.svg"
    },
    "last_trigger": {
      "type": "string",
      "title": {
        "en": "Last Trigger",
        "da": "Seneste hændelse"
      },
      "desc": {
        "en": "What triggered the most recent lock event, e.g. \"unlock by app\" or \"auto lock\"",
        "da": "Hvad der udløste den seneste hændelse, f.eks. \"unlock by app\" eller \"auto lock\""
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/last_trigger.svg"
    },
    "passage_mode_enabled": {
      "type": "boolean",
      "title": {
        "en": "Passage Mode",
        "da": "Gennemgangstilstand"
      },
      "desc": {
        "en": "Whether passage mode (the lock stays unlocked) is enabled",
        "da": "Om gennemgangstilstand (låsen forbliver ulåst) er aktiveret"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/passage_mode.svg"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "lock_operated",
        "title": {
          "en": "Lock was operated",
          "da": "Låsen blev betjent"
        },
        "titleFormatted": {
          "en": "Lock was [[action]]",
          "da": "Låsen blev [[action]]"
        },
        "hint": {
          "en": "Requires the TTLock webhook to be set up (see the app's Settings)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=lock"
          },
          {
            "type": "dropdown",
            "name": "action",
            "values": [
              {
                "id": "any",
                "label": {
                  "en": "locked or unlocked",
                  "da": "låst eller låst op"
                }
              },
              {
                "id": "lock",
                "label": {
                  "en": "locked",
                  "da": "låst"
                }
              },
              {
                "id": "unlock",
                "label": {
                  "en": "unlocked",
                  "da": "låst op"
                }
              }
            ]
          }
        ],
        "tokens": [
          {
            "name": "action",
            "type": "string",
            "title": {
              "en": "Action",
              "da": "Handling"
            },
            "example": {
              "en": "unlocked"
            }
          },
          {
            "name": "operator",
            "type": "string",
            "title": {
              "en": "Operator",
              "da": "Bruger"
            },
            "example": {
              "en": "Anna"
            }
          },
          {
            "name": "method",
            "type": "string",
            "title": {
              "en": "Method",
              "da": "Metode"
            },
            "example": {
              "en": "unlock by fingerprint"
            }
          }
        ]
      },
      {
        "id": "tamper_alert",
        "title": {
          "en": "Tamper alert",
          "da": "Manipulationsalarm"
        },
        "hint": {
          "en": "Requires the TTLock webhook to be set up (see the app's Settings)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=lock"
          }
        ]
      },
      {
        "id": "invalid_attempts",
        "title": {
          "en": "Too many invalid attempts",
          "da": "For mange ugyldige forsøg"
        },
        "hint": {
          "en": "The lock locked itself after too many invalid attempts. Requires the TTLock webhook."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=lock"
          }
        ]
      }
    ],
    "conditions": [],
    "actions": []
  },
  "api": {
    "getWebhookUrl": {
      "method": "GET",
      "path": "/webhook-url"
    }
  }
}
