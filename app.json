{
  "id": "com.briis.ttlock",
  "version": "1.0.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local",
    "cloud"
  ],
  "name": {
    "en": "TTLock",
    "da": "TTLock"
  },
  "description": {
    "en": "Control and monitor your TTLock smart locks",
    "da": "Styr og overvåg dine TTLock smarte låse"
  },
  "category": [
    "security"
  ],
  "brandColor": "#1DA1F2",
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Bjarne Riis",
    "email": "bjarne@briis.com"
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "bjarne@briis.com"
      },
       "githubSponsors": {
         "username": "briis"
       }
    }
  },
  "bugs": {
    "url": "https://github.com/briis/ttlock-homey/issues"
  },
  "source": "https://github.com/briis/ttlock-homey",
  "support": "https://github.com/briis/ttlock-homey/issues",
  "drivers": [
    {
      "id": "lock",
      "name": {
        "en": "Lock",
        "da": "Lås"
      },
      "class": "lock",
      "platforms": [
        "local",
        "cloud"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "locked",
        "measure_battery",
        "alarm_battery"
      ],
      "energy": {
        "batteries": [
          "OTHER"
        ]
      },
      "images": {
        "small": "/drivers/lock/assets/images/small.png",
        "large": "/drivers/lock/assets/images/large.png",
        "xlarge": "/drivers/lock/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials"
        }
      ]
    }
  ],
  "flow": {
    "triggers": [],
    "conditions": [],
    "actions": []
  },
  "settings": [
    {
      "type": "text",
      "id": "ttlockClientId",
      "title": {
        "en": "Client ID",
        "da": "Klient-ID"
      },
      "hint": {
        "en": "Register your own application at open.ttlock.com/manager to get a Client ID and Client Secret, then enter them here before pairing a lock. See the README for details.",
        "da": "Registrer din egen applikation på open.ttlock.com/manager for at få et Klient-ID og en klient-hemmelighed, og indtast dem her, før du parrer en lås. Se README for detaljer."
      },
      "value": ""
    },
    {
      "type": "password",
      "id": "ttlockClientSecret",
      "title": {
        "en": "Client Secret",
        "da": "Klient-hemmelighed"
      },
      "value": ""
    }
  ]
}
